# Compose-level variables, read by docker-compose.yml when provisioning the
# mongodb and redis containers. Copy to `.env` (gitignored) and fill in.
#
# This is NOT the application config — the API reads its own settings from
# apps/api/src/environments/.env, mounted via `env_file` in docker-compose.yml.

MONGO_ROOT_USER=
MONGO_ROOT_PASS=
MONGO_DB_NAME=
REDIS_PASSWORD=

# The read-only Redis account `deploy/inspect.sh` uses. Required: redis refuses
# to start without it, deliberately, rather than starting with an account whose
# password is empty. Any random string; it is never the API's password.
REDIS_INSPECT_PASSWORD=

# The proxy pool, for the receipt-checker container only.
#
# **Deliberately a second copy of what the API already has** in
# apps/api/src/environments/.env, and the duplication is the lesser evil. The
# alternative is handing that file to the checker with `env_file`, which would
# put the database passwords, the Transacto session and the bot token into the
# environment of the one container in this stack that runs a browser against
# somebody else's JavaScript. A proxy list is not a secret; those are.
#
# Keep the two in step. A checker with an empty pool reaches check.gov.ua from
# the host's own address, which is the outcome the pool exists to prevent —
# set PROXY_REQUIRED=true and it refuses instead, and says so on /health.
PROXY_URLS=
PROXY_REQUIRED=

# Host-side published ports, all bound to 127.0.0.1 only. Set one when
# something else on your machine already owns the default — the containers
# always talk to each other on the compose network, so changing these affects
# nothing but your own `redis-cli` / `mongosh` / browser.
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
# ADMIN_HOST_PORT=8090
# RECEIPT_CHECKER_HOST_PORT=8100
