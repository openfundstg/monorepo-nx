# Application config for `apps/api`. Copy to `.env` in this directory — that
# file is gitignored and is mounted into the API container via `env_file` in
# docker-compose.yml. The API will not boot without it.
#
# This is NOT the compose-level file at the workspace root, which only carries
# the Mongo and Redis provisioning credentials.

# --- Core ------------------------------------------------------------------
NODE_ENV=production
PORT=8000
DB_URL=mongodb://mongodb:27017/TraficToBank
REDIS_URL=redis://:password@redis:6379

# --- Admin panel -----------------------------------------------------------
# The single operator identity behind /admin. Both are required: with either
# missing, every login is refused rather than allowed — an unset password locks
# the panel, it does not open it.
#
# Stored in plain text here, like TRANSACTO_PANEL_PASSWORD below, because this
# file is already the place the process's secrets live and hashing one of them
# would protect nothing that reading the file does not already expose. Compared
# in constant time on every attempt, and failed attempts are rate-limited per
# address for 15 minutes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Transacto -------------------------------------------------------------
TRADER_API_BASE_URL=
# The operator panel (app.transacto.us). HTML, session cookie, behind
# Cloudflare — see the `transacto-panel` skill before touching anything here.
TRANSACTO_PANEL_BASE_URL=
TRANSACTO_PANEL_EMAIL=
TRANSACTO_PANEL_PASSWORD=
# Smallest order Transacto will route, in UAH kopecks.
TRANSACTO_MIN_ORDER_KOPECKS=30000

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_GROUP_ID=
TELEGRAM_SUPPORT_WEBHOOK_URL=
TELEGRAM_SUPPORT_WEBHOOK_SECRET=

# --- Mini App --------------------------------------------------------------
TMA_SERVICE_TRADER_API_TOKEN=
TMA_DEPOSIT_EXPIRY_MINUTES=30
# Fiat top-ups (settled by paying a Transacto payout).
# The window the user is shown to pay in — and the deadline for the receipt as
# well: an upload after it is refused, and what is left is an appeal to an
# operator. The payout is still held for the longer window below, because a
# top-up under appeal must not be handed to another trader while a person looks
# at it.
TMA_FIAT_PAY_WINDOW_MINUTES=15
TMA_FIAT_HOLD_MINUTES=30
# How often a receipt's recognition job is polled while a request waits on it.
TMA_FIAT_PARSE_POLL_MS=2000

# --- Receipt verification --------------------------------------------------
# Every fiat receipt is proven before anything reaches Transacto, and each bank
# is proven differently.
#
# **Monobank** goes to monobank's own certification service, which checks the
# qualified electronic signature on the file the user uploaded: a document
# altered by one bit is refused. `check.gov.ua` used to do this job by looking a
# code up in the state register; it needed a real browser for its reCAPTCHA, its
# operator would not tunnel to that host, and a signature is the stronger claim
# anyway. It is gone, and the browser went with it.
#
# **PrivatBank** goes to PrivatBank, which confirms a code and serves its own
# copy of the document — reached over Tor through the Isolated Scraper Worker
# (its `TOR` channel), not from here.
#
# The sidecar container is still here and still does the OCR, which keeps a
# second heavy runtime out of this image. It no longer reaches the internet.
RECEIPT_CHECKER_URL=http://receipt-checker:8100
# Reading text out of an upload. Fast for a PDF's text layer, seconds for OCR.
# The checker enforces its own, shorter deadline on the parsing child; this is
# the API's patience with the checker itself.
RECEIPT_CHECKER_EXTRACT_TIMEOUT_MS=60000
# One signature check against ca.monobank.ua. Measured at 2.0s direct and 2.4s
# through the proxy pool.
MONOBANK_CA_TIMEOUT_MS=30000
# The largest bank document this will accept from PrivatBank.
RECEIPT_DOCUMENT_MAX_BYTES=10485760
# PrivatBank is verified against PrivatBank rather than against check.gov.ua —
# the code their page asks for is a different identifier from the one printed on
# a receipt — and their service needs no browser at all: a clean session with no
# cookies is answered normally. So that path is an ordinary request through the
# proxy pool, and this is its timeout. It shares RECEIPT_DOCUMENT_MAX_BYTES.
PRIVATBANK_DOCUMENT_TIMEOUT_MS=30000
# Refuse a receipt outright when no verifier is configured, instead of sending
# it to Transacto unverified. Leave unset in development; set to `true` in
# production. It fails closed for the same reason PROXY_REQUIRED does — a check
# on somebody's money that silently stops running when its configuration is
# missing is worse than one that was never claimed.
RECEIPT_VERIFICATION_REQUIRED=
MERCHANT_CRYPTO_ADDRESS=
TRONGRID_API_KEY=
REFERRAL_RATE_PERCENT=0.1

# --- Scraper ---------------------------------------------------------------
FUZZY_MATCHING_ENABLED=false
FUZZY_MATCHING_TOLERANCE_UAH=
MONO_POLL_INTERVAL_MS=
# Comma-separated outbound proxies, e.g.
#   http://user:pass@host:10000,http://user:pass@host:10001
# One pool for the whole process, shared by the bank scraper and the Transacto
# panel. The panel's own traffic must go out through it: that host is behind
# Cloudflare, and a block lands on the address, not on the account.
PROXY_URLS=
# Refuse to call out at all when the pool above is empty, instead of quietly
# going direct. Leave unset in development; set to `true` in production, where
# a direct request works right up until the address is blocked and then takes
# everything sharing it down at once.
PROXY_REQUIRED=
# The shared pool above is now the Transacto panel's alone. Every bank path that
# used it has moved to the Isolated Scraper Worker (balance scrapes and the
# monobank signature check on the worker's POOL channel, PrivatBank on its TOR
# channel), so a bank is never reached from this process directly again.

# --- Isolated Scraper Worker ----------------------------------------------
# The throwaway VPS that makes this process's outbound bank requests, so the
# machine holding the data never opens the socket. This process reaches it
# ONLY over Tor: the request goes to the worker's `.onion` address through the
# `tor` container's HTTP tunnel — the same one PrivatBank already uses — so
# neither box learns the other's IP.
#
# The worker holds the proxy pools (its own POOL and TOR channels); this side
# keeps the rotation policy and tells it which channel each destination needs.
# Which bank uses which channel lives in code, not here.
#
# All three are required together, or the worker path refuses to run (there is
# no direct fallback — a direct request is what the worker exists to prevent).
#
#   SCRAPER_WORKER_URL=http://<hash>.onion
#   SCRAPER_WORKER_TOKEN=<the worker's SCRAPER_AUTH_TOKEN, >=32 chars>
#   SCRAPER_WORKER_PROXY_URL=http://tor:9080
SCRAPER_WORKER_URL=
SCRAPER_WORKER_TOKEN=
SCRAPER_WORKER_PROXY_URL=
# Whole-call deadline in ms, generous because it spans a Tor hop plus the
# worker's own 15 s scrape. Defaults to 40000.
SCRAPER_WORKER_TIMEOUT_MS=

TEST_TERMINAL_IDS=
