{
  "name": "@transacto/admin",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "admin",
    "tags": [
      "type:app",
      "scope:admin"
    ],
    "targets": {
      "build": {
        "executor": "@angular/build:application",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "browser": "apps/admin/src/main.ts",
          "outputPath": {
            "base": "apps/admin/dist"
          },
          "index": "apps/admin/src/index.html",
          "tsConfig": "apps/admin/tsconfig.app.json",
          "inlineStyleLanguage": "scss",
          "baseHref": "/admin/",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/admin/public",
              "ignore": [
                "**/*.md"
              ]
            },
            {
              "glob": "**/*",
              "input": "apps/admin/src/assets",
              "output": "assets"
            }
          ],
          "styles": [
            "apps/admin/src/styles.scss"
          ]
        },
        "configurations": {
          "production": {
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "1.2mB",
                "maximumError": "2mB"
              },
              {
                "type": "anyComponentStyle",
                "maximumWarning": "8kB",
                "maximumError": "16kB"
              }
            ],
            "outputHashing": "all",
            "fileReplacements": [
              {
                "replace": "apps/admin/src/environments/environment.ts",
                "with": "apps/admin/src/environments/environment.prod.ts"
              }
            ]
          },
          "development": {
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          }
        },
        "defaultConfiguration": "production"
      },
      "serve": {
        "continuous": true,
        "executor": "@angular/build:dev-server",
        "options": {
          "proxyConfig": "apps/admin/proxy.conf.json"
        },
        "configurations": {
          "production": {
            "buildTarget": "admin:build:production"
          },
          "development": {
            "buildTarget": "admin:build:development"
          }
        },
        "defaultConfiguration": "development"
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "tsc -p tsconfig.app.json --noEmit",
          "cwd": "apps/admin"
        }
      },
      "test": {
        "executor": "@angular/build:unit-test",
        "options": {
          "tsConfig": "apps/admin/tsconfig.spec.json",
          "buildTarget": "admin:build",
          "runner": "vitest",
          "setupFiles": [
            "apps/admin/src/test-setup.ts"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@transacto/contracts": "*",
    "@transacto/history-table": "*",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@ngrx/store-devtools": "^22.0.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
