{
  "name": "@transacto/monobank-extension",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "monobank-extension",
    "tags": [
      "type:app",
      "scope:extension"
    ],
    "targets": {
      "build": {
        "executor": "@angular/build:application",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "browser": "apps/monobank-extension/src/main.ts",
          "outputPath": {
            "base": "apps/monobank-extension/dist",
            "browser": ""
          },
          "index": "apps/monobank-extension/src/index.html",
          "tsConfig": "apps/monobank-extension/tsconfig.app.json",
          "inlineStyleLanguage": "scss",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/monobank-extension/public"
            },
            {
              "glob": "**/*",
              "input": "apps/monobank-extension/src/assets",
              "output": "assets"
            }
          ],
          "styles": [
            "apps/monobank-extension/src/styles.scss"
          ],
          "outputHashing": "none"
        },
        "configurations": {
          "production": {
            "fileReplacements": [
              {
                "replace": "apps/monobank-extension/src/environments/environment.ts",
                "with": "apps/monobank-extension/src/environments/environment.prod.ts"
              }
            ],
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "500kB",
                "maximumError": "1MB"
              },
              {
                "type": "anyComponentStyle",
                "maximumWarning": "10kB",
                "maximumError": "20kB"
              }
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": true
            }
          },
          "development": {
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          }
        },
        "defaultConfiguration": "production"
      },
      "build-worker": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist/background.js"
        ],
        "//": "Must run AFTER build: @angular/build cleans outputPath, which would wipe background.js.",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "tsc -p tsconfig.worker.json",
          "cwd": "apps/monobank-extension"
        }
      },
      "build-extension": {
        "//": "The only target that produces a loadable unpacked extension.",
        "executor": "nx:noop",
        "dependsOn": [
          "build-worker"
        ],
        "configurations": {
          "production": {},
          "development": {}
        },
        "defaultConfiguration": "production"
      },
      "test": {
        "executor": "@angular/build:unit-test",
        "options": {
          "tsConfig": "apps/monobank-extension/tsconfig.spec.json",
          "buildTarget": "monobank-extension:build",
          "runner": "vitest",
          "setupFiles": [
            "apps/monobank-extension/src/test-setup.ts"
          ]
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@angular/build:dev-server",
        "configurations": {
          "production": {
            "buildTarget": "monobank-extension:build:production"
          },
          "development": {
            "buildTarget": "monobank-extension:build:development"
          }
        },
        "defaultConfiguration": "development"
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
          "cwd": "apps/monobank-extension"
        }
      }
    }
  },
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@transacto/contracts": "*",
    "@transacto/history-table": "*",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@types/chrome": "^0.2.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
