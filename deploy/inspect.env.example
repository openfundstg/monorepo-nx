# Copy to deploy/inspect.env (gitignored) once the server side exists —
# deploy/inspect/README.md is the checklist.

# The restricted account, not your own login. Its key is pinned to one command.
TRANSACTO_INSPECT_HOST=inspector@openfunds.top

# The private half of the key you put in that account's authorized_keys.
TRANSACTO_INSPECT_KEY=/home/you/.ssh/transacto_inspect
